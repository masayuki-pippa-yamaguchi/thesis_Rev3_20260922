\providecommand\hyper@newdestlabel[2]{}
\@writefile{toc}{\contentsline {chapter}{付録 C：倒産確率の等高線図および差分図}{158}{appendix*.134}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{C.1 ケース別等高線図（A〜F）}{158}{section*.135}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces ケースA（$D=0.3,\ S=0$）：倒産確率の等高線図。支援能力がなく，負債比率も低いため，境界線は中間的な位置にある。}}{159}{figure.caption.136}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces ケースB（$D=0.3,\ S=3$）：倒産確率の等高線図。強い支援能力により倒産境界線が大きく右へ移動し，市場ショックに対する耐性が高いことがわかる。}}{160}{figure.caption.137}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces ケースC（$D=0.8,\ S=0$）：倒産確率の等高線図。負債過多により境界線が大きく左へ寄り，高ボラティリティ環境で極めて脆弱であることが示される。}}{161}{figure.caption.138}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces ケースD（$D=0.8,\ S=3$）：倒産確率の等高線図。負債比率は高いが支援能力が強いため，ケースCと比べて境界線が右へ戻り，倒産リスクが大幅に緩和されている。}}{162}{figure.caption.139}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces ケースE（$D=0.5,\ S=1$）：倒産確率の等高線図。地域新電力の典型であり，収益性と市場ショックに敏感な構造が確認できる。}}{163}{figure.caption.140}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces ケースF（$D=0.5,\ S=2$）：倒産確率の等高線図。ケースEと比べて境界線が右へ移動し，支援能力の差が倒産リスクを大きく左右することが視覚的に示される。}}{164}{figure.caption.141}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{C.2 差分図（B−C および F−E）}{164}{section*.142}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces 倒産確率差分：大企業（ケースB）$-$ 地方電力（ケースC）。全域で $\Delta p > 0$ となり，支援能力の有無が倒産確率に決定的な差を生むことが確認できる。}}{165}{figure.caption.144}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces 倒産確率差分：商社系（ケースF）$-$ 地域新電力（ケースE）。支援能力 $S$ の差が倒産確率に 0.2〜0.3 程度の差を生み，特に $\sigma $ が大きい領域でその効果が最大化する。}}{166}{figure.caption.146}\protected@file@percent }
