\providecommand\hyper@newdestlabel[2]{}
\@writefile{toc}{\contentsline {chapter}{付録 A：Merton モデルにおける倒産距離の数学的導出}{142}{appendix*.122}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{A.1 Merton モデルの基本構造}{142}{section*.123}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  左図は $\ln V_F(T)$ の正規分布における倒産閾値 $\ln D$ と平均 $\mathbb  {E}[\ln V_F(T)]$ の距離 DD を示す。右図は標準正規分布に写像された倒産閾値 $z$ と平均 0 の距離 $z$ を示す。両図は Merton モデルにおける倒産確率の決定構造（DD → $z$ → $\Phi (-z)$）を視覚的に示している。}}{143}{figure.caption.124}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{A.2 倒産閾値の標準正規分布への写像}{143}{section*.125}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  左図は multiplicative な財務健全性 $H$ を対数変換した財務健全性 $F=\ln H$ の正規分布と倒産閾値 $\mathrm  {Thr}$ の関係を示す。右図は標準正規分布への写像を示し、標準化距離 $Z = DD / \sigma _F$ と倒産確率 $\Phi (-Z)$ の構造がMerton モデルと同一であることを示している。}}{146}{figure.caption.130}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{付録 B：倒産確率の等高線図および差分図}{147}{appendix*.133}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{B.1 ケース別等高線図（A〜F）}{147}{section*.134}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces ケースA（$D=0.3,\ S=0$）：倒産確率の等高線図。支援能力がなく，負債比率も低いため，境界線は中間的な位置にある。}}{148}{figure.caption.135}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces ケースB（$D=0.3,\ S=3$）：倒産確率の等高線図。強い支援能力により倒産境界線が大きく右へ移動し，市場ショックに対する耐性が高いことがわかる。}}{149}{figure.caption.136}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces ケースC（$D=0.8,\ S=0$）：倒産確率の等高線図。負債過多により境界線が大きく左へ寄り，高ボラティリティ環境で極めて脆弱であることが示される。}}{150}{figure.caption.137}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces ケースD（$D=0.8,\ S=3$）：倒産確率の等高線図。負債比率は高いが支援能力が強いため，ケースCと比べて境界線が右へ戻り，倒産リスクが大幅に緩和されている。}}{151}{figure.caption.138}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces ケースE（$D=0.5,\ S=1$）：倒産確率の等高線図。地域新電力の典型であり，収益性と市場ショックに敏感な構造が確認できる。}}{152}{figure.caption.139}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces ケースF（$D=0.5,\ S=2$）：倒産確率の等高線図。ケースEと比べて境界線が右へ移動し，支援能力の差が倒産リスクを大きく左右することが視覚的に示される。}}{153}{figure.caption.140}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{B.2 差分図（B−C および F−E）}{153}{section*.141}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces 倒産確率差分：大企業（ケースB）$-$ 地方電力（ケースC）。全域で $\Delta p > 0$ となり，支援能力の有無が倒産確率に決定的な差を生むことが確認できる。}}{154}{figure.caption.143}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces 倒産確率差分：商社系（ケースF）$-$ 地域新電力（ケースE）。支援能力 $S$ の差が倒産確率に 0.2〜0.3 程度の差を生み，特に $\sigma $ が大きい領域でその効果が最大化する。}}{155}{figure.caption.145}\protected@file@percent }
\newlabel{app:bs_simulation}{{9.7}{156}{付録 C：B\&S 推定式に基づく proxy 妥当性シミュレーション}{appendix*.146}{}}
